PORT=5000
NODE_ENV=development
# Local MongoDB, or an Atlas string: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/event_production?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/event_production
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (no trailing slash), or * for all
CLIENT_ORIGIN=http://localhost:3000
# Optional: set to true to automatically allow preview deployments on *.vercel.app
ALLOW_VERCEL_PREVIEWS=false
